<drawables xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">

    <bitmap id="LauncherIcon" filename="launcher_icon.svg" dithering="none"/>

    <!-- Variantes branca/preta pra suportar a config. "Inverter Cores".
         dithering="floyd_steinberg" (em vez de "none") espalha o erro de
         arredondamento nos pixels vizinhos, disfarçando o serrilhado das
         bordas curvas no display 1-bit (mesma tecnica das faces nativas). -->
    <bitmap id="HeartIconWhite" filename="heart.svg" dithering="floyd_steinberg"/>
    <bitmap id="HeartIconBlack" filename="heart_black.svg" dithering="floyd_steinberg"/>
    <bitmap id="BatteryIconWhite" filename="battery.svg" dithering="floyd_steinberg"/>
    <bitmap id="BatteryIconBlack" filename="battery_black.svg" dithering="floyd_steinberg"/>

</drawables>